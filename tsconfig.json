{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/root/*": ["./*"],
      "@/public/*": ["./public/*"],
      "@/types": ["./types"],
      "@/i18n/*": ["./i18n/*"],
      "@/services": ["./services"],
      "@/store": ["./store"],
      "@/lib/*": ["./lib/*"],
      "@/shadcn/*": ["./components/ui/*"],
      "@/components": ["./app/components"],
      "@/components/*": ["./app/components/*"],
      "@/icons": ["./app/components/icons"],
      "@/utils/*": ["./app/utils/*"],
      "@/users/*": ["./app/[locale]/(protected)/users/*"],
      "@/events/*": ["./app/[locale]/(protected)/events/*"],
      "@/event-cards/*": ["./app/[locale]/(protected)/invitation-cards/*"],
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
